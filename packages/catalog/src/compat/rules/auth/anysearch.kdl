auth "anysearch" {
	name "AnySearch"
	env "ANYSEARCH_API_KEY"
	login "api-key" {
		auth-url "https://anysearch.com/console/api-keys"
		instructions "Create or copy your AnySearch API key from the AnySearch console. A key is optional for anonymous search, but recommended for higher rate limits."
		prompt "Paste your AnySearch API key" placeholder="API key"
	}
}
